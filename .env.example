# testset-generator environment (see docs/design/02-architecture.md §2.4)
# Copy to .env for `docker compose up`.

# --- Postgres ---
POSTGRES_PASSWORD=postgres

# --- API ---
SECRET_KEY=change-me-in-production
# postgresql+psycopg://postgres:<POSTGRES_PASSWORD>@postgres:5432/testset_gen
# (set automatically by docker-compose.yml; override only for external DB)
# DATABASE_URL=

# --- LLM (design 02.4) ---
# openai | anthropic | ollama
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# For LLM_PROVIDER=ollama (or `docker compose --profile local up`):
OLLAMA_BASE_URL=

# --- Ports / CORS ---
API_PORT=8000
WEB_PORT=8080
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Frontend ---
# Baked into the SPA at build time. Leave empty for demo mode (mock data
# when the API is unreachable — used on the Cloudflare Pages demo).
VITE_API_URL=
